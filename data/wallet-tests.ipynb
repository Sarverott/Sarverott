    "import yaml\n",
    "import solders\n",
    "\n",
    "wallets_dict = None\n",
    "\n",
    "with open(\"./wallets.yaml\") as wallet_data:\n",
    "    wallets_dict = yaml.load(wallet_data.read(), Loader=yaml.Loader)\n",
    "    \n",
    "key = solders.pubkey.Pubkey.from_string(wallets_dict[\"general\"][\"solana\"][\"pub\"])\n",
    "print(key.is_on_curve())\n",
    "\n"
   ]
