---
import DefaultViewPage from "../components/DefaultViewPage.astro";
import { BASE } from "../lib/base";
import { getSitePages, UPDATES_FEED } from "../lib/site";
import { getUpdates } from "../lib/updates";

const LATEST_UPDATES = 10;

const pages = getSitePages();
const updates = (await getUpdates()).slice(0, LATEST_UPDATES);
---

<DefaultViewPage title="sitemap">
	<h2>content</h2>
	<ul>
		{pages.map(({ path }) => (
			<li><a href={`${BASE}${path}`}>{path}</a></li>
		))}
	</ul>
	<h2>latest updates</h2>
	<ul>
		{updates.map(({ title, link, pubDate, source }) => (
			<li>
				<time datetime={pubDate.toISOString()}>{pubDate.toISOString().slice(0, 10)}</time>{" "}
				<a href={link}>{title}</a> - {source.title}
			</li>
		))}
	</ul>
	<p>
		<a href={UPDATES_FEED.url}>{UPDATES_FEED.title}</a> | <a href={`${BASE}/sitemap.xml`}>sitemap.xml</a> | <a href={`${BASE}/all-feeds.opml`}>all-feeds.opml</a>
	</p>
</DefaultViewPage>
