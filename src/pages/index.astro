---
import {createHash} from 'node:crypto'
import config from '../../data/basic.config.json'



function gravatarIcon(email: string){
	let hashedmail = createHash("sha256")
	hashedmail.update(email)
	return `https://gravatar.com/avatar/${hashedmail.digest('hex')}.ico?s=128`
}

function gravatarAvatar(email: string){
	let hashedmail = createHash("sha256")
	hashedmail.update(email)
	return `https://gravatar.com/avatar/${hashedmail.digest('hex')}`
}

const EMAIL = config.emails[0]

const UPDATES_FEED={
	title: config.rss.title,
	url: config.rss.output,
	mimetype: config.rss.mimetype
}

const WEBMANIFEST_URL = "/manifest.json"

const SITEMAP_LINK = {
	title: "map of Sarverott's domain",
	url: "/sitemap.xml"
}

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href={gravatarIcon(EMAIL)} />
		<meta name="generator" content={Astro.generator} />
		<link rel="manifest" href={WEBMANIFEST_URL} crossorigin="anonymous" />
		<link rel="sitemap" type="application/xml" title={SITEMAP_LINK.title} href={SITEMAP_LINK.url} crossorigin="anonymous" />
		<link rel="alternate" title={UPDATES_FEED.title} href={UPDATES_FEED.url} type={UPDATES_FEED.mimetype} />
		<title>Sett.Sarverott.com</title>
	</head>
	<body>
		<h1>{Astro.url}</h1>
		<br />
		<img src={gravatarAvatar(EMAIL)} />
		<br />
		<h3>{EMAIL}</h3>
	</body>
</html>
