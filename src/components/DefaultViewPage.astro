---
import "bulma/css/bulma.min.css";
import { BASE } from "../lib/base";
import { getGotoLinks } from "../lib/goto";
import {
	EMAIL,
	FOOTER_REFS,
	gravatarAvatar,
	gravatarIcon,
	NAME,
	SITEMAP_LINK,
	UPDATES_FEED,
	WEBMANIFEST_URL,
} from "../lib/site";
import AsideContext from "./layouts/default/AsideContext.vue";
import FooterRefs from "./layouts/default/FooterRefs.vue";
import HeaderNav from "./layouts/default/HeaderNav.vue";
import MainSpace from "./layouts/default/MainSpace.vue";

interface Props {
	title?: string;
}

const { title = "Sett.Sarverott.com" } = Astro.props;

const links = await getGotoLinks();
const socmed = links.filter((link) => link.group === "socmed");

// one crumb per url segment, each linked to its own level
const segments = Astro.url.pathname
	.slice(BASE.length)
	.split("/")
	.filter(Boolean);
const crumbs = [
	{ title: Astro.url.host, url: `${BASE}/` },
	...segments.map((segment, index) => ({
		title: segment,
		url: `${BASE}/${segments.slice(0, index + 1).join("/")}/`,
	})),
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href={gravatarIcon(EMAIL)} />
		<meta name="generator" content={Astro.generator} />
		<link rel="manifest" href={WEBMANIFEST_URL} crossorigin="anonymous" />
		<link rel="sitemap" type="application/xml" title={SITEMAP_LINK.title} href={SITEMAP_LINK.url} crossorigin="anonymous" />
		<link rel="alternate" title={UPDATES_FEED.title} href={UPDATES_FEED.url} type={UPDATES_FEED.mimetype} />
		<title>{title}</title>
	</head>
	<body>
		<HeaderNav avatar={gravatarAvatar(EMAIL)} name={NAME} socmed={socmed} crumbs={crumbs} />
		<div class="columns">
			<div class="column is-three-quarters">
				<MainSpace><slot /></MainSpace>
			</div>
			<div class="column">
				<AsideContext avatar={gravatarAvatar(EMAIL)} name={NAME} email={EMAIL} links={links} />
			</div>
		</div>
		<FooterRefs items={FOOTER_REFS} />
	</body>
</html>
