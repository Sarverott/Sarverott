---
import "bulma/css/bulma.min.css";
import { getEntry } from "astro:content";
import { marked } from "marked";
import particlesConfig from "../../data/bg-particles.error.json";
import { GROUPS, getGotoLinks } from "../lib/goto";
import { FOOTER_REFS } from "../lib/site";
import FooterRefs from "./layouts/error/FooterRefs.vue";
import HeaderNav from "./layouts/error/HeaderNav.vue";
import MainSpace from "./layouts/error/MainSpace.vue";
import ParticleJsBackground from "./layouts/ParticleJsBackground.vue";

interface Props {
	status: number; // has to be listed in data/httpstatus.csv
}

const { status } = Astro.props;

const entry = await getEntry("httpstatus", String(status));
if (!entry)
	throw new Error(`status ${status} is missing in data/httpstatus.csv`);

const { title, message } = entry.data;

const links = await getGotoLinks();
const groups = GROUPS.map((group) => ({
	group,
	links: links.filter((link) => link.group === group),
})).filter((group) => group.links.length);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>{status} {title}</title>
		<slot name="head" />
	</head>
	<body>
		<ParticleJsBackground client:only="vue" config={particlesConfig} />
		<HeaderNav
			domain={Astro.url.host}
			status={status}
			socmed={links.filter((link) => link.group === "socmed")}
			groups={groups}
		/>
		<MainSpace status={status} title={title}>
			<p set:html={marked.parseInline(message)} />
			<slot />
		</MainSpace>
		<FooterRefs items={FOOTER_REFS} />
	</body>
</html>
