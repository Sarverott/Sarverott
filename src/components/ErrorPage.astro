---
import { getEntry } from "astro:content";
import { marked } from "marked";
import HttpCat from "./HttpCat.astro";

interface Props {
  status: number; // has to be listed in data/httpstatus.csv
}

const { status } = Astro.props;

const entry = await getEntry("httpstatus", String(status));
if (!entry) throw new Error(`status ${status} is missing in data/httpstatus.csv`);

const { title, message } = entry.data;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>{status} {title}</title>
		<slot name="head" />
	</head>
	<body>
		<h1>{status}</h1>
		<h3>{title}</h3>
		<HttpCat code={status} />
		<p set:html={marked.parseInline(message)} />
		<slot />
		<a href={import.meta.env.BASE_URL}>sett.sarverott.com</a>
	</body>
</html>
